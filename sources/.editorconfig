# top-most EditorConfig file for this level
root = true

# All files
[*]
indent_style = space
# Code files
[*.{cs,csx}]
# C# files
[*.cs]
#### Core EditorConfig Options ####
# Indentation and spacing
indent_size = 4
tab_width = 4
# New line preferences
end_of_line = crlf
insert_final_newline = true

max_line_length = 150

